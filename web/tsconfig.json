{
  // Browser code, type-checked only: `npm run typecheck`. The Rust build (crates/teltonika-panel/
  // build.rs) strips the types with oxc. src/types is generated from the Rust structs by `cargo test`.
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
