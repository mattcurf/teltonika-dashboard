{
  "name": "teltonika-panel",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "setup-hooks": "node --env-file-if-exists=.env src/setup-hooks.ts",
    "test": "node --test test/*.test.ts",
    "mock:up": "docker compose -f compose.mock.yaml up -d --build --wait",
    "mock:down": "docker compose -f compose.mock.yaml down"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
