{
  "name": "teltonika-panel-tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "mock:up": "docker compose -f compose.mock.yaml up -d --build --wait",
    "mock:down": "docker compose -f compose.mock.yaml down"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "description": "Device mocks and end-to-end tests for the Teltonika panel. The panel itself is the Rust crate in crates/."
}
