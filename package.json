{
  "name": "teltonika-panel-tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "build:web": "tsc -p web",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit",
    "test": "node --test test/*.test.ts",
    "mock:up": "docker compose -f compose.mock.yaml up -d --build --wait",
    "mock:down": "docker compose -f compose.mock.yaml down"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "description": "TypeScript tooling for the Teltonika panel: the browser code in web/, the device mocks and the end-to-end tests. The server is the Rust workspace in crates/."
}
